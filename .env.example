# Kali Security MCP Server -- environment configuration
# Copy to ".env" and adjust. All values shown are the built-in defaults.
#
#   cp .env.example .env

# ---------------------------------------------------------------------------
# Paths
# ---------------------------------------------------------------------------
# Where tool output, reports, and crack results are written (mounted volume).
MCP_OUTPUT_DIR=/data
# Root directory under which wordlists must live to be accepted by tools.
MCP_WORDLIST_DIR=/usr/share/wordlists

# ---------------------------------------------------------------------------
# Execution limits
# ---------------------------------------------------------------------------
# Default per-tool timeout in seconds when a tool call does not specify one.
MCP_DEFAULT_TIMEOUT=300
# Hard ceiling: a tool call may never request a timeout above this.
MCP_MAX_TIMEOUT=1800
# Tool output is truncated to this many bytes before being returned.
MCP_MAX_OUTPUT_BYTES=100000

# ---------------------------------------------------------------------------
# Transport
# ---------------------------------------------------------------------------
# "stdio" (default, for Claude Desktop / local clients) or "http".
MCP_TRANSPORT=stdio
# Used only when MCP_TRANSPORT=http.
MCP_HTTP_HOST=0.0.0.0
MCP_HTTP_PORT=8000

# Logging verbosity: DEBUG, INFO, WARNING, ERROR. Logs go to stderr only.
MCP_LOG_LEVEL=INFO

# ---------------------------------------------------------------------------
# Scope control  (STRONGLY RECOMMENDED)
# ---------------------------------------------------------------------------
# Comma-separated IPs/CIDRs. When MCP_ALLOWED_TARGETS is set, every target is
# checked against it and anything outside the list is refused before a tool
# runs. Leave blank to allow any target (only do this in an isolated lab).
#
# Example -- restrict to a single lab subnet:
#   MCP_ALLOWED_TARGETS=10.0.10.0/24,192.168.56.0/24
MCP_ALLOWED_TARGETS=

# Comma-separated IPs/CIDRs that are always refused, even if otherwise in
# scope. The cloud metadata endpoint is blocked by default to prevent SSRF
# style pivots from tools like sqlmap/ZAP/nikto.
MCP_BLOCKED_TARGETS=169.254.169.254/32

# ---------------------------------------------------------------------------
# OWASP ZAP
# ---------------------------------------------------------------------------
ZAP_PATH=/usr/share/zaproxy/zap.sh
ZAP_HOST=127.0.0.1
ZAP_PORT=8090
# API key for the local ZAP daemon. Leave blank to auto-generate one per run.
ZAP_API_KEY=

# ---------------------------------------------------------------------------
# WPScan
# ---------------------------------------------------------------------------
# Optional token from wpscan.com -- enables vulnerability data enrichment.
WPSCAN_API_TOKEN=
